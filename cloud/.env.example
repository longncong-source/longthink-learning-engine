# Second Brain — SHORT-TERM online cache (Internet/Cloud, ephemeral, qua OpenClaw/ChatGPT/Gemini)
# Copy to cloud/.env (never commit the real .env)
# ARCH: First (long-term local) ↔ Mid ↔ Second (short-term online)
# Second is NOT durable — data có TTL, cần internet, hỗ trợ trực tuyến

ENVIRONMENT=development

# Backend cho SHORT-TERM cache: sqlite (dev) | postgres (prod) — nhưng có TTL, không phải nguồn chân lý
MEMORY_DB_BACKEND=sqlite
SQLITE_PATH=data/second_brain.sqlite3
DATABASE_URL=postgresql://second_brain:second_brain@localhost:5433/second_brain
# TTL cho short-term cache (ngày) — 0 = không hết hạn (giữ tương thích cũ, đặt 7 để đúng short-term)
SHORT_TERM_TTL_DAYS=7

# Comma-separated API keys. Clients send: X-API-Key: <key> or Authorization: Bearer <key>
MEMORY_API_KEYS=dev-local-key

# Online LLM provider cho Second (internet) — openclaw | openai | gemini | none
ONLINE_LLM_PROVIDER=openclaw
ONLINE_LLM_MODEL=gpt-4o
OPENCLAW_API_KEY=
OPENCLAW_BASE_URL=
OPENAI_API_KEY=
GEMINI_API_KEY=

# Embeddings: hash (offline) | ollama (11434) | openai_compatible | lmstudio (1234/v1) — LMStudio = OpenAI-compatible local
EMBEDDING_PROVIDER=hash
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_DIMENSION=384
EMBEDDING_BASE_URL=http://localhost:11434
# Ví dụ LMStudio: EMBEDDING_PROVIDER=lmstudio, EMBEDDING_MODEL=text-embedding-nomic-embed-text-v1.5, EMBEDDING_BASE_URL=http://127.0.0.1:1234/v1, EMBEDDING_DIMENSION=768

# Hybrid search weights (section 9 of spec). Do not assume optimal; tune per project.
WEIGHT_SEMANTIC=0.60
WEIGHT_KEYWORD=0.20
WEIGHT_IMPORTANCE=0.10
WEIGHT_RECENCY=0.10
RECENCY_HALF_LIFE_DAYS=30

# Duplicate memory suppression (cosine similarity threshold)
DEDUPE_THRESHOLD=0.92

RATE_LIMIT_PER_MINUTE=240

# Mid Brain (Third Brain - Intelligence Layer)
MID_BRAIN_FIRST_BRAIN_URL=http://127.0.0.1:8100
MID_BRAIN_SECOND_BRAIN_URL=http://127.0.0.1:8100
MID_BRAIN_ENABLE_REFLECTION=true
MID_BRAIN_ENABLE_LEARNING=true
MID_BRAIN_ENABLE_CONFLICT_DETECTION=true
MID_BRAIN_ENABLE_REFERENCE=true
MID_BRAIN_ENABLE_PLANNING=true
MID_BRAIN_ENABLE_AGENT=true
MID_BRAIN_ENABLE_CONFIDENCE=true
MID_BRAIN_ENABLE_NETWORK=true
MID_BRAIN_ENABLE_OBSIDIAN=false
MID_BRAIN_OBSIDIAN_VAULT_PATH=
MID_BRAIN_CONFIDENCE_THRESHOLD=0.5

COMFY_URL=http://127.0.0.1:8188  # ComfyUI local bridge (moon base visuals)
