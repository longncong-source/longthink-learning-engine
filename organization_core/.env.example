# LONGTHINK ORGANIZATION CORE — environment template (Phase 12).
# Copy to organization_core/.env (or export). Never commit real secrets.

# Service
ORGANIZATION_CORE_HOST=127.0.0.1
ORGANIZATION_CORE_PORT=8101
ORGANIZATION_CORE_DB=data/organization.sqlite3

# API auth (Phase 11 integration point). Empty = open local mode (dev only).
# Production: set a strong csv list, e.g. ORGANIZATION_CORE_API_KEYS=key1,key2
ORGANIZATION_CORE_API_KEYS=

# Rate limiting (Phase 11). Empty = off. Production: e.g. 240
ORGANIZATION_CORE_RATE_LIMIT_PER_MINUTE=

# Knowledge Core (Second Brain cloud API). Empty = mock adapter (dev/tests).
# Production: ORGANIZATION_CORE_KNOWLEDGE_URL=http://127.0.0.1:8100
ORGANIZATION_CORE_KNOWLEDGE_URL=
ORGANIZATION_CORE_KNOWLEDGE_API_KEY=
ORGANIZATION_CORE_KNOWLEDGE_TIMEOUT_SECONDS=10
ORGANIZATION_CORE_KNOWLEDGE_MAX_RETRIES=2

# Intelligence Core (Mid Brain routes on the same cloud API). Empty = mock.
ORGANIZATION_CORE_INTELLIGENCE_URL=
ORGANIZATION_CORE_INTELLIGENCE_API_KEY=
ORGANIZATION_CORE_INTELLIGENCE_TIMEOUT_SECONDS=10
ORGANIZATION_CORE_INTELLIGENCE_MAX_RETRIES=2
