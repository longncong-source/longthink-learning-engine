# First Brain (local) — LONG-TERM durable store (duy nhất có trạng thái dài hạn)
# Copy to local/.env (never commit the real .env)
# ARCH: First (long-term local) ↔ Mid ↔ Second (short-term online cache via OpenClaw/ChatGPT/Gemini)

LLM_PROVIDER=ollama
# ollama (11434) | lmstudio (1234/v1) | none (offline extractive)
LLM_BASE_URL=
LLM_MODEL=llama3.2
# Ví dụ LMStudio: LLM_PROVIDER=lmstudio, LLM_MODEL=vistral-7b-chat, LLM_BASE_URL=http://127.0.0.1:1234/v1
LLM_API_KEY=

# First Brain long-term storage (local, persistent, never TTL)
LOCAL_LONG_TERM_DB=local_data/long_term.sqlite3
LOCAL_DATA_DIR=local_data

# Second Brain — SHORT-TERM online cache (ephemeral, internet)
SECOND_BRAIN_URL=http://127.0.0.1:8100
SECOND_BRAIN_API_KEY=dev-local-key
SECOND_BRAIN_PROVIDER=openclaw
# openclaw | chatgpt | gemini | custom
SECOND_BRAIN_MODEL=gpt-4o
OPENCLAW_API_KEY=
OPENCLAW_BASE_URL=
OPENAI_API_KEY=
GEMINI_API_KEY=

MEMORY_TOP_K=8

# local_only | selective | cloud_allowed (default selective) — controls what may be sent to Second (short-term online)
DATA_POLICY=selective

# Obsidian integration (Phase 8/10)
OBSIDIAN_VAULT_PATH=

CACHE_TTL_SECONDS=600
REQUEST_TIMEOUT_SECONDS=30

COMFY_URL=http://127.0.0.1:8188  # ComfyUI local bridge
